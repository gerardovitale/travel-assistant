# Build context = repo root (workspace). See deploy.yaml / makefile.
FROM python:3.13-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.6 /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY commodity-fetcher/ ./commodity-fetcher/
COPY fuel-ingestor/pyproject.toml ./fuel-ingestor/
COPY fuel-dashboard/pyproject.toml ./fuel-dashboard/
RUN uv sync --frozen --no-install-project --no-editable --package commodity-fetcher

FROM python:3.13-slim
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY ./commodity-fetcher/src/ ./src/
COPY ./commodity-fetcher/tests/ ./tests/
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app/src
ENTRYPOINT ["pytest", "--durations=5", "-vv", "/app/tests/"]

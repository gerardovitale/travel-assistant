# Build context = repo root (workspace). See deploy.yaml / makefile.
FROM python:3.13-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.6 /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY spain-fuel-fetcher/ ./spain-fuel-fetcher/
COPY fuel-dashboard/pyproject.toml ./fuel-dashboard/
COPY fuel-ingestor/pyproject.toml ./fuel-ingestor/
RUN uv sync --frozen --no-install-project --no-editable --package fuel-dashboard

FROM python:3.13-slim
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY ./fuel-dashboard/app/ ./
COPY ./fuel-dashboard/tests/ ./tests/
# tests/test_idae_ingest_pipeline.py imports the idae_*.py scripts (fuel-dashboard/pyproject.toml's
# `pythonpath = ["app", "../scripts"]` covers this locally; that ini file isn't copied into this
# image, so PYTHONPATH does the same job here).
COPY ./scripts/ /scripts/
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH=/app:/scripts
ENTRYPOINT ["pytest", "--durations=5", "-vv", "/app/tests/"]
